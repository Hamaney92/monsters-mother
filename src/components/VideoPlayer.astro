---
import {copy} from '../data/i18n';
const {lang='en'}=Astro.props;const t=copy[lang];
const play:Record<string,string>={en:'Play the film',fr:'Lancer le film',tr:'Filmi oynat',ar:'شغّل الفيلم'};
---
<div class="video-player" data-video-player>
  <div class="video-prompt">
    <p class="eyebrow">MYTHRA · THE MOTHERS MONSTER</p>
    <p>She Gave Birth to a Dragon</p>
    <button class="button" type="button">{play[lang] || play.en} ▶</button>
    <small>{t?.privacy || 'Loads YouTube’s privacy-enhanced player. YouTube receives connection data when you load it.'}</small>
  </div>
</div>
<p class="video-source">MYTHRA · <a data-youtube-source href="https://www.youtube.com/watch?v=dqCGNrQ6N_o" target="_blank" rel="noopener noreferrer">{t?.youtube || 'Watch on YouTube'} ↗</a>{lang==='en' && '. If playback is unavailable here, use this link.'}</p>
<script>
import {initVideo} from '../lib/video';
document.querySelectorAll<HTMLElement>('[data-video-player]').forEach(player => {
  initVideo(player);
});
</script>
<style>
.video-player{aspect-ratio:16/9;background:radial-gradient(ellipse at center,#45281e,#161615 75%);border:1px solid #65503c;display:grid;place-items:center;overflow:hidden}.video-prompt{padding:2rem;text-align:center;display:grid;justify-items:center;gap:1rem}.video-prompt>p:not(.eyebrow){font-family:Georgia,serif;font-size:clamp(1.4rem,4vw,3rem);margin:0}.video-prompt small{max-width:34rem;color:#c7bcae}.video-player :global(iframe){width:100%;height:100%;border:0}.video-source{font-size:1rem;color:#c7bcae}.video-source a{text-decoration:underline}@media(max-width:600px){.video-player{aspect-ratio:auto;min-height:300px}.video-player:has(iframe){aspect-ratio:16/9;min-height:0}.video-prompt{padding:1.4rem}}
</style>
<style>
.video-player{min-width:0;width:100%;grid-template-columns:minmax(0,1fr)}
.video-player :global(iframe){min-width:0;max-width:100%;min-height:200px}
@media(max-width:650px){
  .video-player{min-height:240px}
  .video-player:has(iframe){min-height:200px}
  .video-player :global(iframe){min-height:200px}
  .video-prompt{padding:1rem;gap:.7rem}
  .video-prompt .eyebrow{font-size:.65rem;margin:0}
  .video-prompt small{font-size:.75rem}
  .video-prompt .button{min-height:48px}
}
</style>
