---
import { getEntry } from 'astro:content';
import { path } from '../site';
import { routeFor } from '../data/i18n';
import { readingBooks, readingRoute } from '../data/reader';
interface Props { lang?: string; }
const {lang='en'}=Astro.props;
const text={
  en:{title:'Prefer to read?',intro:'Meet Elara and her dragon child, Ember, in the illustrated novel by YH.',note:'Read the complete book free in English: 26 chapters, no sign-up. The paperback edition on Amazon is in English.',start:'Read Book One free',read:'Read the Chapter One excerpt',book:'About the illustrated book',quote:'Opening line in English'},
  fr:{title:'Et si vous entriez dans le roman ?',intro:'Découvrez Elara et son enfant dragon, Ember, dans le roman illustré de YH.',note:'Le tome 1 complet est gratuit en français. Les 26 chapitres sont accessibles sans inscription. Le broché vendu sur Amazon est en anglais.',start:'Lire gratuitement le chapitre 1 en français',read:'Lire l’extrait du chapitre 1 en anglais',book:'Découvrir le livre illustré',quote:'Première phrase en français'},
  tr:{title:'Hikâyeyi okumak ister misiniz?',intro:'YH’nin resimli romanında Elara ve ejderha çocuğu Ember ile tanışın.',note:'Birinci kitabın tamamını Türkçe ücretsiz okuyabilirsiniz: 26 bölüm, kayıt gerektirmez. Amazon’daki basılı kitap İngilizcedir.',start:'Kitabı Türkçe ücretsiz oku',read:'İlk bölümü İngilizce oku',book:'Resimli romanı keşfet',quote:'Türkçe açılış cümlesi'},
  ar:{title:'هل تود اكتشاف الرواية؟',intro:'تعرّف إلى إلارا وطفلها التنين إمبر في الرواية المصوّرة للكاتب YH.',note:'يمكنك قراءة الكتاب الأول كاملًا بالعربية مجانًا. جميع فصوله الستة والعشرين متاحة دون تسجيل. النسخة الورقية المباعة على Amazon باللغة الإنجليزية.',start:'اقرأ الفصل الأول مجانًا بالعربية',read:'اقرأ مقتطف الفصل الأول بالإنجليزية',book:'اكتشف الرواية المصوّرة',quote:'الجملة الافتتاحية بالعربية'}
};
const t=text[lang as keyof typeof text]||text.en;
const completeBook=readingBooks.find(book=>book.language===lang);
const book=await getEntry('books','book-one');
const chapter=await getEntry('chapters','book-one-chapter-one');
if(!book || !chapter?.body) throw new Error('Missing book or chapter for film reader invitation');
const quoteLanguage = lang === 'fr' || lang === 'tr' || lang === 'ar' ? lang : 'en';
const translatedChapter = quoteLanguage === 'en' ? undefined : completeBook?.chapters[0];
const opening = quoteLanguage === 'en'
  ? chapter.body.trim().split(/\r?\n\s*\r?\n/)[0]
  : translatedChapter?.paragraphs[0];
if (!opening) throw new Error(`Missing ${quoteLanguage} opening paragraph for film reader invitation`);
const chapterRoute = readingRoute(lang, 1);
const excerptRoute = routeFor(lang, 'read');
const quoteRoute = quoteLanguage === 'en' ? excerptRoute : chapterRoute;
const arrow = lang === 'ar' ? '←' : '→';
---
<section class="film-book-invitation" aria-labelledby="film-reader-invitation">
  <h2 id="film-reader-invitation">{t.title}</h2>
  <p class="invitation-book" lang="en" dir="ltr">{book.data.title}<span>{book.data.subtitle} · {book.data.author}</span></p>
  <p>{t.intro}</p>
  <blockquote lang={quoteLanguage} dir={quoteLanguage === 'ar' ? 'rtl' : 'ltr'} cite={path(quoteRoute)}>{opening}</blockquote>
  <p class="invitation-caption">{translatedChapter?.title ?? 'The First Breath'} · {t.quote}</p>
  <p class="invitation-note">{t.note}</p>
  <div class="invitation-actions">
    {completeBook && <a class="button" href={path(chapterRoute)}>{t.start} {arrow}</a>}
    <a class="text-link" href={path(excerptRoute)}>{t.read} {arrow}</a>
    <a class="text-link" href={path(routeFor(lang, 'story'))}>{t.book} {arrow}</a>
  </div>
</section>
<style>
  .film-book-invitation{margin-block:2rem 3rem;padding:clamp(1rem,3vw,2rem);border:1px solid var(--line);border-inline-start:3px solid var(--copper);background:var(--panel);text-align:start}
  .film-book-invitation h2{font-size:clamp(1.8rem,4vw,2.4rem);margin:0 0 1rem}
  .invitation-book{font-family:'Cormorant Garamond',Georgia,serif;font-size:1.8rem;color:var(--ivory);line-height:1.2;margin:0}
  .invitation-book span{display:block;font-family:Manrope,Arial,sans-serif;font-size:.8rem;line-height:1.6;margin-top:.5rem;color:var(--muted)}
  blockquote{font-family:Georgia,serif;font-style:italic;font-size:1.15rem;line-height:1.7;margin:1rem 0 .5rem;color:var(--ivory)}
  .film-book-invitation .invitation-caption{font-size:.75rem;margin:0 0 1rem;color:var(--muted)}
  .film-book-invitation .invitation-note{font-size:.85rem;line-height:1.7}
  .invitation-actions{display:flex;align-items:center;gap:1rem 1.5rem;flex-wrap:wrap}
  .invitation-actions .button{white-space:normal;text-align:center;max-width:100%;line-height:1.5}
  @media(max-width:480px){.invitation-actions{align-items:stretch;flex-direction:column}.invitation-actions .text-link{align-self:flex-start}}
</style>
