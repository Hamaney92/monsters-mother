---
import {ui} from '../data/i18n';
import { getCollection } from 'astro:content';
const books = (await getCollection('books', ({data}) => data.published)).sort((a,b) => a.data.order-b.data.order);
const { compact = false, lang = 'en' } = Astro.props;
---
{books[0]?.data.amazon && <a class:list={['button', 'amazon', { compact }]} href={books[0].data.amazon} target="_blank" rel="noopener noreferrer">{lang==='en' ? (compact ? 'Get the book' : 'Find it on Amazon') : ui[lang].buy} <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>}
