---
import ArtImage from './ArtImage.astro';
import { archiveGuides } from '../data/archiveGuides';
import { readingRoute, readerUi, type ReadingLanguage } from '../data/reader';
import { path } from '../site';

interface Props { lang?: ReadingLanguage; section: 'world' | 'lore'; }
const { lang = 'en', section } = Astro.props;
const guide = archiveGuides[lang][section];
const images = section === 'world'
  ? ['cave-scene.webp', 'hearth-scene.webp', 'world-art.webp']
  : ['ember-scene.webp', 'shawl-scene.webp', 'hearth-scene.webp'];
const arrow = lang === 'ar' ? '←' : '→';
---
<section class="section cinematic-archive archive-guide" lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'} data-archive-guide={section}>
  <div class="guide-intro">
    <p>{guide.intro}</p>
    <p class="spoiler-note">{guide.spoilerNote}</p>
  </div>
  {guide.sections.map((entry, index) => <article class="scene-row" aria-labelledby={`${section}-${entry.id}`}>
    <figure class="scene-frame">
      <ArtImage src={path(images[index])} alt="" width="1200" height="800" loading="lazy"/>
      <figcaption><span>{readerUi[lang].chapter} {entry.chapter}</span></figcaption>
    </figure>
    <div class="scene-copy">
      <h2 id={`${section}-${entry.id}`}>{entry.title}</h2>
      <div class="scene-rule" aria-hidden="true"></div>
      {entry.paragraphs.map(paragraph => <p>{paragraph}</p>)}
      <p class="reading-question">{entry.question}</p>
      <a class="text-link" href={path(readingRoute(lang, entry.chapter))}>{entry.readLabel} {arrow}</a>
    </div>
  </article>)}
  <aside class="guide-closing" aria-labelledby={`${section}-continue`}>
    <h2 id={`${section}-continue`}>{guide.closingTitle}</h2>
    <p>{guide.closing}</p>
    <a class="text-link" href={path(readingRoute(lang))}>{guide.bookLabel} {arrow}</a>
  </aside>
</section>
<style>
  .archive-guide{padding-top:2rem}
  .guide-intro{max-width:760px;margin:0 auto 4rem}
  .guide-intro>p:first-child{font-size:1.1rem;color:var(--ivory)}
  .spoiler-note{font-size:.86rem;border-inline-start:2px solid var(--copper);padding-inline-start:1rem}
  .archive-guide .scene-row{align-items:start;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);gap:5%;margin-block:0 5rem}
  .archive-guide .scene-row:nth-child(even){grid-template-columns:minmax(0,1.15fr) minmax(0,1fr)}
  .archive-guide .scene-row:nth-child(even) .scene-frame{order:2}
  .archive-guide .scene-copy{min-width:0;max-width:66ch}
  .scene-copy h2{font-size:clamp(2.2rem,3.5vw,3.3rem);overflow-wrap:break-word}
  .scene-copy p{font-size:1rem;line-height:1.95}
  .reading-question{border-inline-start:2px solid var(--copper);padding-inline-start:1rem;color:var(--ivory)}
  .archive-guide .text-link{max-width:100%;min-height:44px;line-height:1.65;overflow-wrap:anywhere;white-space:normal}
  .scene-frame figcaption span{font:inherit;letter-spacing:.08em}
  .guide-closing{border-top:1px solid var(--line);padding-top:2rem;max-width:760px;margin:auto}
  .guide-closing h2{font-size:clamp(2rem,4vw,2.8rem)}
  @media(max-width:850px){
    .archive-guide .scene-row,.archive-guide .scene-row:nth-child(even){grid-template-columns:minmax(0,1fr);gap:2rem}
    .archive-guide .scene-row:nth-child(even) .scene-frame{order:0}
    .scene-frame{width:100%;max-width:760px;margin:auto;aspect-ratio:16/9}
    .archive-guide .scene-copy{padding:0;max-width:760px;margin:auto;width:100%}
    .guide-intro{margin-bottom:3rem}
  }
</style>
