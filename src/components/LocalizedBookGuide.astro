---
import { getCollection } from 'astro:content';
import ArtImage from './ArtImage.astro';
import { path } from '../site';
import { routeFor } from '../data/i18n';
const { lang } = Astro.props;
const books = (await getCollection('books', ({data}) => data.published)).sort((a,b) => a.data.order-b.data.order);
const book = books[0];
const translations = {
  fr: {
    details:'L’édition brochée', author:'Auteur', language:'Langue du livre', english:'Anglais', format:'Format', paperback:'Broché · illustrations intérieures en noir et blanc', length:'Nombre de pages', pages:'pages', listing:'Consultez Amazon pour le prix actuel et la livraison dans votre pays.',
    guide:'Avant de commencer la lecture',
    questions:[
      ['Le livre entier est-il gratuit ?', 'Non. Le site propose le premier chapitre complet, pas le roman entier. Vous pouvez le lire gratuitement en anglais, sans compte ni adresse e-mail, puis décider si vous souhaitez poursuivre avec le livre.'],
      ['Existe-t-il une traduction française du roman ?', 'Le roman et l’extrait présentés ici sont en anglais. Les pages françaises expliquent l’histoire et son univers ; elles ne constituent pas une édition française du livre.'],
      ['Le roman contient-il des illustrations ?', 'Oui. Le broché contient des dessins en noir et blanc qui accompagnent le récit. Les images en couleur du site présentent les personnages et l’atmosphère : ce ne sont pas les pages imprimées à l’intérieur.'],
      ['The Mothers Monster et A Monster’s Mother sont-ils le même titre ?', 'The Mothers Monster, également présenté sous le titre She Gave Birth to a Dragon, est le titre de la vidéo. A Monster’s Mother: A Cradle Made of Embers est le roman de YH présenté sur ce site. Le guide du film permet de retrouver la vidéo et sa source.']
    ],
    caption:'Aperçu réel du broché : page 8, chapitre 2, « Back Through the Snow ».', alt:'Page intérieure en noir et blanc : Elara porte le dragon nouveau-né près d’une grotte enneigée ; numéro de page 8.', print:'Cet aperçu numérique montre une page entière de l’édition anglaise, avec ses marges. Le contraste sur papier peut différer de celui d’un écran.', navigation:'Pour continuer', read:'Lire le chapitre 1 (anglais)', film:'Le film et sa source', characters:'Rencontrer Elara et Ember'
  },
  tr: {
    details:'Basılı kitap bilgileri', author:'Yazar', language:'Kitabın dili', english:'İngilizce', format:'Biçim', paperback:'Karton kapak · siyah-beyaz iç çizimler', length:'Sayfa sayısı', pages:'sayfa', listing:'Güncel fiyatı ve ülkenize teslimat seçeneklerini Amazon’da kontrol edin.',
    guide:'Okumaya başlamadan önce',
    questions:[
      ['Kitabın tamamı ücretsiz mi?', 'Hayır. Bu site romanın tamamını değil, ilk bölümün tamamını paylaşır. Bölümü İngilizce olarak ücretsiz, hesap açmadan ve e-posta adresi vermeden okuyabilir; ardından kitaba devam edip etmeyeceğinize karar verebilirsiniz.'],
      ['Romanın Türkçe çevirisi var mı?', 'Burada sunulan roman ve örnek bölüm İngilizcedir. Türkçe sayfalar hikâyeyi ve dünyasını tanıtır; kitabın Türkçe bir baskısı değildir.'],
      ['Kitapta çizimler var mı?', 'Evet. Basılı kitabın içinde hikâyeye eşlik eden siyah-beyaz çizimler bulunur. Sitedeki renkli görseller karakterleri ve atmosferi tanıtır; kitabın içindeki basılı sayfalar değildir.'],
      ['The Mothers Monster ile A Monster’s Mother aynı başlık mı?', 'The Mothers Monster, She Gave Birth to a Dragon adıyla da sunulan videonun başlığıdır. A Monster’s Mother: A Cradle Made of Embers ise bu sitede tanıtılan YH romanıdır. Film rehberinden videoya ve kaynağına ulaşabilirsiniz.']
    ],
    caption:'Basılı kitaptan gerçek bir önizleme: sayfa 8, ikinci bölüm, “Back Through the Snow”.', alt:'Siyah-beyaz iç sayfa: Elara karlı bir mağaranın yanında yeni doğmuş ejderhayı tutuyor; sayfa numarası 8.', print:'Bu dijital önizleme, İngilizce baskıdan kenar boşluklarıyla birlikte tam bir sayfa gösterir. Basılı kâğıdın kontrastı ekrandakinden farklı olabilir.', navigation:'Keşfetmeye devam edin', read:'İlk bölümü oku (İngilizce)', film:'Film ve kaynağı', characters:'Elara ve Ember’ı tanıyın'
  },
  ar: {
    details:'تفاصيل النسخة الورقية', author:'الكاتب', language:'لغة الكتاب', english:'الإنجليزية', format:'النوع', paperback:'غلاف ورقي · رسوم داخلية بالأبيض والأسود', length:'عدد الصفحات', pages:'صفحة', listing:'راجع صفحة Amazon لمعرفة السعر الحالي وخيارات التوصيل إلى بلدك.',
    guide:'قبل أن تبدأ القراءة',
    questions:[
      ['هل الكتاب كاملًا مجاني؟', 'لا. يتيح الموقع الفصل الأول كاملًا، وليس الرواية كلها. يمكنك قراءته مجانًا بالإنجليزية دون إنشاء حساب أو تقديم بريد إلكتروني، ثم تقرر إن كنت ترغب في متابعة القراءة في الكتاب.'],
      ['هل توجد نسخة عربية من الرواية هنا؟', 'الرواية والفصل المعروضان هنا بالإنجليزية. تقدم الصفحات العربية تعريفًا بالقصة وعالمها، وليست نسخة مترجمة من الكتاب.'],
      ['هل يحتوي الكتاب على رسوم؟', 'نعم. ترافق القصة في النسخة الورقية رسوم بالأبيض والأسود. أما الصور الملونة على الموقع فتقدم الشخصيات وأجواء الرواية؛ وهي ليست الصفحات المطبوعة داخل الكتاب.'],
      ['هل The Mothers Monster وA Monster’s Mother هما العنوان نفسه؟', 'The Mothers Monster، المعروف أيضًا بعنوان She Gave Birth to a Dragon، هو عنوان الفيديو. أما A Monster’s Mother: A Cradle Made of Embers فهي رواية YH المقدمة على هذا الموقع. يتيح دليل الفيلم الوصول إلى الفيديو ومصدره.']
    ],
    caption:'معاينة فعلية للنسخة الورقية: الصفحة 8 من الفصل الثاني، «Back Through the Snow».', alt:'صفحة داخلية بالأبيض والأسود تظهر إلارا تحمل التنين حديث الولادة قرب كهف ثلجي، مع رقم الصفحة 8.', print:'تعرض هذه المعاينة الرقمية صفحة كاملة من النسخة الإنجليزية، بما فيها الهوامش. قد يختلف التباين على الورق عن ظهوره على الشاشة.', navigation:'تابع اكتشاف القصة', read:'اقرأ الفصل الأول بالإنجليزية', film:'الفيلم ومصدره', characters:'تعرف إلى إلارا وإمبر'
  }
};
const t = translations[lang as keyof typeof translations];
if (!t || !book?.data.paperback) throw new Error('Missing localized paperback guide data');
const local = (route:string) => path(routeFor(lang, route));
---
<section class="localized-book-guide" aria-labelledby="localized-book-details">
  <h2 id="localized-book-details">{t.details}</h2>
  <dl>
    <div><dt>{t.author}</dt><dd dir="ltr">{book.data.author}</dd></div>
    <div><dt>{t.language}</dt><dd>{t.english}</dd></div>
    <div><dt>{t.format}</dt><dd>{t.paperback}</dd></div>
    <div><dt>{t.length}</dt><dd>{book.data.paperback.pages} {t.pages}</dd></div>
    <div><dt>ISBN-13</dt><dd dir="ltr">{book.data.paperback.isbn}</dd></div>
  </dl>
  <p><a href={book.data.amazon} target="_blank" rel="noopener noreferrer">{t.listing}</a></p>
  <h2>{t.guide}</h2>
  {t.questions.map(([question,answer]) => <><h3>{question}</h3><p>{answer}</p></>)}
  <figure class="paperback-preview">
    <ArtImage src={path('interior-page-8.webp')} alt={t.alt} loading="lazy" sizes="(max-width: 600px) 90vw, 420px"/>
    <figcaption>{t.caption}</figcaption>
  </figure>
  <p>{t.print}</p>
  <nav aria-label={t.navigation}><a href={local('read')}>{t.read}</a> · <a href={local('movie')}>{t.film}</a> · <a href={local('characters')}>{t.characters}</a></nav>
</section>
<style>
  .localized-book-guide{margin-top:3rem;padding-top:2rem;border-top:1px solid var(--line)}
  .localized-book-guide h3{font-size:1.8rem;line-height:1.2;margin-top:2rem}
  dl div{display:grid;grid-template-columns:minmax(6rem,1fr) 2fr;gap:1rem;padding-block:.35rem}
  dt{font-weight:600}dd{margin:0;overflow-wrap:anywhere}
  .paperback-preview{max-width:420px;margin:2rem auto}
  .paperback-preview :global(img){display:block;width:100%;height:auto;background:#fff}
  figcaption{font-size:.9rem;line-height:1.6;color:var(--muted);margin-top:1rem}
  a{text-decoration:underline;text-underline-offset:.2em}nav{line-height:2;margin-top:2rem}
  @media(max-width:400px){dl div{grid-template-columns:1fr;gap:.1rem}}
</style>
