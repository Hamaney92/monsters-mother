---
const {lang='en'}=Astro.props;
const words={
 en:{free:'Free chapter · No signup required · English text',size:'Text size',small:'Smaller text',large:'Larger text',progress:'Chapter reading progress',end:'Finished the sample?',next:'Continue Elara and Ember’s story, or explore the world without spoiling what comes next.',people:'Meet the characters',world:'Explore the world'},
 fr:{free:'Chapitre gratuit · Sans inscription · Texte en anglais',size:'Taille du texte',small:'Réduire le texte',large:'Agrandir le texte',progress:'Progression dans le chapitre',end:'Vous avez terminé l’extrait ?',next:'Poursuivez l’histoire d’Elara et Ember, ou explorez leur univers sans découvrir la suite.',people:'Rencontrer les personnages',world:'Explorer les lieux'},
 tr:{free:'Ücretsiz bölüm · Kayıt gerektirmez · İngilizce metin',size:'Metin boyutu',small:'Metni küçült',large:'Metni büyüt',progress:'Bölüm okuma ilerlemesi',end:'Örneği bitirdiniz mi?',next:'Elara ve Ember’ın hikâyesine devam edin veya sonraki olayları öğrenmeden dünyalarını keşfedin.',people:'Karakterleri tanıyın',world:'Dünyayı keşfedin'},
 ar:{free:'فصل مجاني · دون تسجيل · النص بالإنجليزية',size:'حجم النص',small:'تصغير النص',large:'تكبير النص',progress:'تقدم قراءة الفصل',end:'هل انتهيت من المقتطف؟',next:'تابع حكاية إلارا وإمبر أو اكتشف عالمهما دون كشف أحداث القصة التالية.',people:'تعرّف على الشخصيات',world:'اكتشف العالم'}
};
const t=words[lang as keyof typeof words]||words.en;
---
<div class="reading-tools" data-reading-tools>
 <p>{t.free}</p>
 <div class="reading-options"><span>{t.size}</span><button type="button" data-reading-size="smaller" aria-label={t.small}>A−</button><button type="button" data-reading-size="larger" aria-label={t.large}>A+</button></div>
 <progress value="0" max="100" aria-label={t.progress}></progress>
</div>
<style>
 .reading-tools{max-width:760px;margin:0 auto 2rem;padding:1rem 1.5rem;border-block:1px solid var(--line,#514736)}
 .reading-tools p{font-size:.85rem;margin:0 0 .75rem;color:var(--muted,#bdb5a6)}
 .reading-options{display:flex;align-items:center;gap:.75rem;font-size:.85rem}
 button{min-width:44px;min-height:44px;background:transparent;color:inherit;border:1px solid #756549;cursor:pointer;border-radius:3px}
 button:focus-visible{outline:2px solid #dfb779;outline-offset:3px}button:disabled{opacity:.4;cursor:default}
 progress{display:block;width:100%;height:4px;margin-top:1rem;accent-color:#dfb779}
</style>
<script>
 const tools=document.querySelector<HTMLElement>('[data-reading-tools]');
 const story=document.querySelector<HTMLElement>('[data-reading-content], .chapter');
 if(tools&&story){
  const progress=tools.querySelector('progress');
  const buttons=Array.from(tools.querySelectorAll<HTMLButtonElement>('[data-reading-size]'));
  const paragraphs=Array.from(story.querySelectorAll<HTMLElement>('p, li')).filter(p=>!p.closest('.chapter-end'));
  const initial=paragraphs.map(p=>parseFloat(getComputedStyle(p).fontSize));let step=0;
  buttons.forEach(button=>button.addEventListener('click',()=>{
   step=Math.max(-1,Math.min(3,step+(button.dataset.readingSize==='larger'?1:-1)));
   paragraphs.forEach((p,i)=>p.style.fontSize=`${initial[i]*(1+step*.12)}px`);
   buttons.forEach(b=>b.disabled=b.dataset.readingSize==='larger'?step===3:step===-1);
  }));
  let pending=false;
  function updateProgress(){const rect=story!.getBoundingClientRect();if(progress)progress.value=Math.max(0,Math.min(100,(innerHeight-rect.top)/rect.height*100));pending=false;}
  addEventListener('scroll',()=>{if(!pending){pending=true;requestAnimationFrame(updateProgress);}},{passive:true});
  addEventListener('resize',updateProgress);updateProgress();
 }
</script>
