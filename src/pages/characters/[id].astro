---
import Layout from '../../layouts/Layout.astro';
import Amazon from '../../components/Amazon.astro';
import { archive } from '../../data/archive';
import { path } from '../../site';
export function getStaticPaths(){return archive.map(character=>({params:{id:character.id},props:{character}}));}
const {character}=Astro.props;
---
<Layout title={character.title} description={character.description}><section class="page-heading"><a class="eyebrow" href={path('characters/')}>← THE CHARACTERS / BOOK I</a><h1>{character.title}</h1><p>{character.label}</p></section><article class="prose"><div class:list={['character-portrait',character.id]}><img src={path(character.id==='nessa'?'healer-art.webp':'cover-art.webp')} alt={character.id==='nessa'?'A healer preparing herbs, atmospheric illustration':character.title+' from the cover artwork'} width="1024" height="1536" loading="lazy"/></div>{character.paragraphs.map(p=><p>{p}</p>)}<div class="actions"><Amazon/><a class="text-link" href={path('read/')}>Read Chapter One free →</a></div></article></Layout>
