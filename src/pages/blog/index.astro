---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { path } from '../../site';
const posts=(await getCollection('blog',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<Layout title="The Ember Journal" description="Original essays on monsters, motherhood and the shadows of dark fantasy."><section class="page-heading"><p class="eyebrow">NOTES FROM THE DARK</p><h1>The Ember <em>Journal</em></h1><p>On monsters, motherhood, and the stories we carry into the dark.</p></section><section class="section journal-grid">{posts.map((post,i)=><a class="journal-card" href={path(`blog/${post.id}/`)}><div class="journal-art"><img src={path(post.id==='she-gave-birth-to-a-dragon'?'cover-art.webp':post.id==='monstrous-motherhood'?'brand-dragon.png':post.id==='dark-fantasy-gothic-fantasy'?'world-art.webp':'lore-art.webp')} class:list={{'emblem-art':post.id==='monstrous-motherhood'}} alt="" width="1000" height="667" loading="lazy"/></div><p class="eyebrow">{post.data.category}</p><h2>{post.data.title}</h2><p>{post.data.description}</p><span class="text-link">Read the essay ↗</span></a>)}</section></Layout>
