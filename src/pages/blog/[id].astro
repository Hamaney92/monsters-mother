---
import ArtImage from "../../components/ArtImage.astro";
import { journalArt } from '../../data/journalArt';
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Amazon from '../../components/Amazon.astro';
import { path } from '../../site';
export async function getStaticPaths(){return (await getCollection('blog',({data})=>!data.draft)).map(post=>({params:{id:post.id},props:{post}}));}
const {post}=Astro.props;const {Content}=await render(post);
const related=(await getCollection('blog',({data})=>!data.draft)).filter(p=>p.id!==post.id).slice(0,2);
---
<Layout title={post.data.title} description={post.data.description} article schema={{'@context':'https://schema.org','@type':'BlogPosting',headline:post.data.title,description:post.data.description,datePublished:post.data.date.toISOString(),dateModified:(post.data.modified ?? post.data.date).toISOString(),author:{'@type':'Organization',name:post.data.author},mainEntityOfPage:new URL(path(`blog/${post.id}/`),Astro.site).href,image:new URL(path(journalArt(post.id).file),Astro.site).href}}><article><header class="page-heading article-heading"><a class="eyebrow" href={path('blog/')}>← THE EMBER JOURNAL / {post.data.category}</a><h1>{post.data.title}</h1><p>{post.data.description}</p><div class="byline">{post.data.author} · <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'})}</time>{post.data.modified && <> · Updated <time datetime={post.data.modified.toISOString()}>{post.data.modified.toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'})}</time></>}</div></header><figure class="article-visual editorial-art"><ArtImage src={path(journalArt(post.id).file)} alt={journalArt(post.id).alt} width="1200" height="800"/><figcaption>THE EMBER JOURNAL · {post.data.category}</figcaption></figure><div class="prose"><Content/>{post.id==='she-gave-birth-to-a-dragon' && <nav class="reading-path" aria-label="Continue exploring"><a href={path('movie/')}>Watch the MYTHRA video →</a><a href={path('characters/elara/')}>Meet Elara →</a><a href={path('characters/ember/')}>Meet Ember →</a><a href={path('read/')}>Read Chapter One free →</a></nav>}</div></article><aside class="book-band"><p class="eyebrow">CONTINUE INTO THE DARK</p><h2>A Monster’s Mother</h2><p>A Cradle Made of Embers · A novel by YH</p><div class="actions" style="justify-content:center"><a class="text-link" href={path('read/')}>Read Chapter One free →</a><Amazon/></div></aside><section class="section related"><h2>Keep reading</h2>{related.map(p=><a href={path(`blog/${p.id}/`)}>{p.data.title} →</a>)}</section></Layout>
