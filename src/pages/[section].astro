---
import ArtImage from "../components/ArtImage.astro";
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Amazon from '../components/Amazon.astro';
import ReadingTools from '../components/ReadingTools.astro';
import { path } from '../site';
import { archive } from '../data/archive';
export function getStaticPaths(){return [
 {section:'world',title:'The World',eyebrow:'THE ATLAS',heading:'A world beyond the barred door.',description:'Explore the cave, the village and the home at the heart of Elara and Ember’s story.'},
 {section:'characters',title:'The Characters',eyebrow:'THE PEOPLE',heading:'A mother. A son. A fragile trust.',description:'Meet Elara, Ember and Nessa from A Monster’s Mother: A Cradle Made of Embers.'},
 {section:'lore',title:'The Lore',eyebrow:'THE ARCHIVE',heading:'Small things. Lasting meaning.',description:'Discover the significance of Ember’s name, Elara’s shawl and the hearth in A Monster’s Mother.'},
 {section:'read',title:'Read Chapter One',eyebrow:'THE READING ROOM',heading:'The first ember.',description:'Read Chapter One of A Monster’s Mother: A Cradle Made of Embers by YH, free. Meet Elara and her dragon child in The First Breath.'}
].map(data=>({params:{section:data.section},props:data}));}
const {section,title,eyebrow,heading,description}=Astro.props;
const chapter = section==='read' ? await getEntry('chapters', 'book-one-chapter-one') : undefined;
const renderedChapter = chapter ? await render(chapter) : undefined;
const ChapterContent = renderedChapter?.Content;
const world=[['01 / THE CAVE','The first threshold','Snow blows across the entrance of a cave above the village. Here, Elara sees her child for the first time: pale pink scales, uncertain movements and wings too awkward to manage.'],['02 / THE HOUSE','A shelter with a secret','A barred door divides Elara’s home from the village. Inside are a hearth, a shawl, a water bowl and a child who grows faster than the space can hold him.'],['03 / THE VILLAGE','Where every absence is noticed','Neighbours share a lane and notice each other’s lives. Nessa’s first question about the baby makes clear how difficult it will be for Elara to hide what has happened.']];
const lore=[['01 / A NAME','Why Ember?','Elara names him while he watches a red point glow beneath the ash. She has tried human names in her thoughts, but this one belongs to the small warm creature leaning into her hand.'],['02 / AN ORDINARY OBJECT','The shawl','Ember wants something of Elara’s beneath his head when he sleeps. He rejects a replacement cloth and follows the familiar shawl. A simple piece of clothing becomes part of how he finds safety.'],['03 / A PLACE OF CARE','The hearth','The hearth gives the house warmth and a place for mother and child to sit together. In the early chapters, it is a domestic centre: a place to feed, watch, rest and learn.']];
---
<Layout title={title} description={description} ><section class="page-heading"><p class="eyebrow">{eyebrow}</p><h1>{heading}</h1><p>{description}</p></section>
{section==='read' && <ReadingTools/>}
{section==='characters' ? <section class="section character-gallery">{archive.map(c=><article class="character-tile"><div class:list={['character-portrait',c.id]}><ArtImage src={path(c.id+'-scene.webp')} alt={'Portrait of '+c.title} width="1024" height="1536" loading="lazy"/></div><div class="character-copy"><p class="eyebrow">{c.label}</p><h2>{c.title}</h2><p>{c.description}</p><a class="text-link" href={path(`characters/${c.id}/`)}>Meet {c.title} →</a></div></article>)}</section> : section==='read' ? <article class="prose chapter"><p class="eyebrow">BOOK I · CHAPTER ONE · YH</p><h2>The First Breath</h2>{ChapterContent && <ChapterContent/>}<aside class="chapter-end"><p class="eyebrow">THE STORY CONTINUES</p><h2>Her next step changes everything.</h2><p>Continue Elara and Ember’s story in <i>A Monster’s Mother: A Cradle Made of Embers</i>.</p><div class="actions"><Amazon/><a class="text-link" href={path('characters/')}>Meet the characters →</a></div></aside></article> : <section class="section cinematic-archive">{(section==='world'?world:lore).map(([label,name,body],i)=><article class="scene-row"><figure class="scene-frame"><ArtImage src={path((section==='world'?['cave-scene.webp','hearth-scene.webp','world-art.webp']:['ember-scene.webp','shawl-scene.webp','hearth-scene.webp'])[i])} alt={name+' — atmospheric illustration'} width="1200" height="800" loading="lazy"/><figcaption>BOOK I <span>0{i+1}</span></figcaption></figure><div class="scene-copy"><p class="eyebrow">{label}</p><h2>{name}</h2><div class="scene-rule" aria-hidden="true"></div><p>{body}</p></div></article>)}<p class="source-note">A spoiler-light guide to the opening chapters of Book I.</p><div class="actions"><Amazon/><a class="text-link" href={path('characters/')}>Meet the characters →</a></div></section>}
</Layout>
