---
import ArtImage from "../components/ArtImage.astro";
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Amazon from '../components/Amazon.astro';
import ReadingTools from '../components/ReadingTools.astro';
import ArchiveGuide from '../components/ArchiveGuide.astro';
import { path } from '../site';
import { archive } from '../data/archive';
export function getStaticPaths(){return [
 {section:'world',title:'The World',eyebrow:'THE ATLAS',heading:'A world beyond the barred door.',description:'Explore the cave, the village and the home at the heart of Elara and Ember’s story.'},
 {section:'characters',title:'The Characters',eyebrow:'THE PEOPLE',heading:'A mother. A son. A fragile trust.',description:'Meet Elara, Ember and Nessa from A Monster’s Mother: A Cradle Made of Embers.'},
 {section:'lore',title:'The Lore',eyebrow:'THE ARCHIVE',heading:'Small things. Lasting meaning.',description:'Discover the significance of Ember’s name, Elara’s shawl and the hearth in A Monster’s Mother.'},
 {section:'read',title:'Read Chapter One',eyebrow:'THE READING ROOM',heading:'The first ember.',description:'Read Chapter One of A Monster’s Mother: A Cradle Made of Embers by YH, free. Meet Elara and her dragon child in The First Breath.'}
].map(data=>({params:{section:data.section},props:data}));}
const {section,title,eyebrow,heading,description}=Astro.props;
const chapter = section==='read' ? await getEntry('chapters', 'book-one-chapter-one') : undefined;
const renderedChapter = chapter ? await render(chapter) : undefined;
const ChapterContent = renderedChapter?.Content;
---
<Layout title={title} description={description} ><section class="page-heading"><p class="eyebrow">{eyebrow}</p><h1>{heading}</h1><p>{description}</p></section>
{section==='read' && <ReadingTools/>}
{section==='characters' ? <section class="section character-gallery">{archive.map(c=><article class="character-tile"><div class:list={['character-portrait',c.id]}><ArtImage src={path(c.id+'-scene.webp')} alt={'Portrait of '+c.title} width="1024" height="1536" loading="lazy"/></div><div class="character-copy"><p class="eyebrow">{c.label}</p><h2>{c.title}</h2><p>{c.description}</p><a class="text-link" href={path(`characters/${c.id}/`)}>Meet {c.title} →</a></div></article>)}</section> : section==='read' ? <article class="prose chapter"><p class="eyebrow">BOOK I · CHAPTER ONE · YH</p><h2>The First Breath</h2>{ChapterContent && <ChapterContent/>}<aside class="chapter-end"><p class="eyebrow">THE STORY CONTINUES</p><h2>Her next step changes everything.</h2><p>Continue Elara and Ember’s story in <i>A Monster’s Mother: A Cradle Made of Embers</i>.</p><div class="actions"><Amazon/><a class="text-link" href={path('characters/')}>Meet the characters →</a></div></aside></article> : <ArchiveGuide section={section==='world'?'world':'lore'}/>}
</Layout>
