---
import ArtImage from "../components/ArtImage.astro";
import { journalArt } from '../data/journalArt';
import Layout from '../layouts/Layout.astro';
import Amazon from '../components/Amazon.astro';
import { path, site } from '../site';
import { getCollection } from 'astro:content';
const posts=(await getCollection('blog',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,3);
---
<Layout schema={{'@context':'https://schema.org','@type':'WebSite',name:site.title,url:new URL(path(),Astro.site).href}}>
<section class="hero"><ArtImage class="hero-art" src={path('cover-art.webp')} alt="" width="1024" height="1536" fetchpriority="high"/><div class="hero-shade"></div><div class="hero-content"><p class="eyebrow"><span></span> A NOVEL BY YH</p><h1>A Monster’s<br/><em>Mother</em></h1><p class="subtitle">A CRADLE MADE OF EMBERS</p><div class="fine-rule"></div><p class="hero-quote">They called him a monster.<br/>She called him her son.</p><div class="actions"><a class="button" href={path('read/')}>Read the free chapter <span aria-hidden="true">→</span></a><a class="text-link" href={path('movie/')}>Watch the film <span aria-hidden="true">▶</span></a></div></div><div class="hero-bottom"><span>LOVE HAS A DARKER SIDE.</span><a href="#discover">SCROLL TO DISCOVER <span aria-hidden="true">↓</span></a><span>BOOK I</span></div></section>
<section class="intro section" id="discover"><div><p class="eyebrow">01 / THE STORY</p><h2>How far would you go<br/>for <em>the one you love?</em></h2></div><div><p class="lead">A child with scales and wings.<br/>A mother who takes him home.<br/>A village that will not understand.</p><p>Step inside <i>A Monster’s Mother: A Cradle Made of Embers</i>, a novel by YH.</p><a class="text-link" href={path('story/')}>Discover the book <span aria-hidden="true">→</span></a></div></section>
<section class="section world-section"><div class="section-heading"><div><p class="eyebrow">02 / BEYOND THE PAGES</p><h2>Every life<br/>has <em>a story.</em></h2></div><p>The world, the people, the secrets.<br/>Enter Elara and Ember’s story.</p></div><div class="portal-grid">{[['01','The World','Beyond the familiar. Into the unknown.','world/'],['02','The Characters','Behind every monster, a story.','characters/'],['03','The Lore','Some stories refuse to stay buried.','lore/']].map(([n,title,desc,url])=><a class="portal" href={path(url)}><ArtImage class="portal-image" src={path(n==='01'?'world-art.webp':n==='02'?'cover-art.webp':'lore-art.webp')} alt="" width="1000" height="667" loading="lazy"/><span class="portal-number">{n} / EXPLORE</span><div><h3>{title}</h3><p>{desc}</p><span class="text-link">Open the archive <span aria-hidden="true">↗</span></span></div></a>)}</div></section>
<section class="reading-band"><span class="ornament" aria-hidden="true">✧</span><p class="eyebrow">THE FIRST SPARK</p><h2>Every fire begins<br/>with <em>a single ember.</em></h2><p>Read the opening chapter. Meet the child who changes everything.</p><a class="button secondary" href={path('read/')}>Read Chapter One <span aria-hidden="true">→</span></a></section>
<section class="section journal-section"><div class="section-heading"><div><p class="eyebrow">03 / NOTES FROM THE DARK</p><h2>The Ember <em>Journal</em></h2></div><a class="text-link" href={path('blog/')}>All stories <span aria-hidden="true">→</span></a></div><div class="journal-grid">{posts.map((post)=><a class="journal-card" href={path(`blog/${post.id}/`)}><div class="journal-art editorial-art"><ArtImage src={path(journalArt(post.id).file)} alt={journalArt(post.id).alt} width="1200" height="800" loading="lazy"/><span class="art-label" aria-hidden="true">THE EMBER JOURNAL</span></div><p class="eyebrow">{post.data.category}</p><h3>{post.data.title}</h3><p>{post.data.description}</p><span class="text-link">Read the essay <span aria-hidden="true">↗</span></span></a>)}</div></section>
<section class="reading-band"><p class="eyebrow">ON SCREEN · MYTHRA</p><h2>She gave birth<br/>to <em>a dragon.</em></h2><p>Discover the video, then step into Elara and Ember’s story.</p><a class="button secondary" href={path('movie/')}>Watch the video ▶</a></section><section class="book-band"><p class="eyebrow">A MONSTER’S MOTHER · BOOK I</p><h2>A Cradle Made of Embers</h2><p>Begin with the book.</p><Amazon/></section>
</Layout>
