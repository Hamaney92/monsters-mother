---
import Layout from '../../layouts/Layout.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import {getEntry,render} from 'astro:content';
import {copy,ui,routeFor,essayIds} from '../../data/i18n';
import {journalArt} from '../../data/journalArt';
import {path} from '../../site';
export function getStaticPaths(){return ['fr','ar','tr'].flatMap(lang=>['','story','world','characters','lore','blog','film','read',...['elara','ember','nessa'].map(x=>'characters/'+x),...essayIds.map(x=>'blog/'+x)].map(page=>({params:{lang,page:page||undefined}})));}
const lang=Astro.params.lang!;const page=Astro.params.page||'';const t=copy[lang],u=ui[lang];
const ids=['elara','ember','nessa'];const charIndex=ids.indexOf(page.split('/')[1]);const essayIndex=essayIds.indexOf(page.split('/')[1]);
const title=page.startsWith('blog/')?t.essays[essayIndex][0]:page.startsWith('characters/')?t.characters[charIndex][0]:({'':t.sub,story:t.storyTitle,world:t.worldTitle,characters:t.charactersTitle,lore:t.loreTitle,blog:t.journalTitle,film:t.filmTitle,read:t.readTitle} as Record<string,string>)[page];
const description=page.startsWith('blog/')?t.essays[essayIndex][1]:page==='film'?t.filmIntro:page==='blog'?t.journalIntro:t.note;
const local=(p='')=>path(routeFor(lang,p));
const chapter=page==='read'?await getEntry('chapters','book-one-chapter-one'):undefined;const rendered=chapter?await render(chapter):undefined;const Chapter=rendered?.Content;
---
<Layout lang={lang} title={page.startsWith('characters/')?title+' — '+t.characters[charIndex][1]:title} description={description} schema={{'@context':'https://schema.org','@type':page.startsWith('blog/')?'BlogPosting':'WebPage',name:title,inLanguage:lang,url:new URL(Astro.url.pathname,Astro.site).href}}>
{page==='' ? <><section class="hero"><img class="hero-art" src={path('cover-art.webp')} alt="" width="1024" height="1536" fetchpriority="high"/><div class="hero-shade"></div><div class="hero-content"><p class="eyebrow">{t.sub}</p><h1 dir="ltr">A Monster’s<br/><em>Mother</em></h1><p class="subtitle" dir="ltr">A CRADLE MADE OF EMBERS</p><p class="hero-quote">{t.tag}</p><div class="actions"><a class="button" href={local('movie')}>{t.watch} ▶</a><a class="text-link" href={local('story')}>{t.enter} →</a></div></div></section><section class="section intro"><h2>{t.storyTitle}</h2><div><p>{t.story}</p><a class="text-link" href={local('read')}>{u.read} →</a></div></section><section class="section portal-grid">{['world','characters','lore'].map((p,i)=><a class="portal" href={local(p)}><img class="portal-image" src={path(['world-art.webp','elara-scene.webp','lore-art.webp'][i])} alt="" width="1200" height="800" loading="lazy"/><span class="portal-number">0{i+1}</span><h2>{u.nav[i+1]}</h2></a>)}</section><section class="book-band"><h2>{t.journalTitle}</h2><p>{t.journalIntro}</p><a class="button secondary" href={local('blog')}>{u.nav[4]} →</a></section></> : <section class="page-heading"><p class="eyebrow" dir="ltr">A MONSTER’S MOTHER · YH</p><h1>{title}</h1><p>{description}</p></section>}
{page==='story' && <article class="prose"><p class="lead">{t.story}</p><p>{t.story2}</p><img src={path('elara-scene.webp')} width="1024" height="1536" alt={t.characters[0][0]} loading="lazy"/><a class="text-link" href={local('read')}>{u.read} →</a></article>}
{(page==='world'||page==='lore') && <section class="section cinematic-archive">{t[page].map((row:string[],i:number)=><article class="scene-row"><figure class="scene-frame"><img src={path((page==='world'?['cave-scene.webp','hearth-scene.webp','world-art.webp']:['ember-scene.webp','shawl-scene.webp','hearth-scene.webp'])[i])} alt={row[1]} width="1200" height="800" loading="lazy"/><figcaption>0{i+1}</figcaption></figure><div class="scene-copy"><p class="eyebrow">{row[0]}</p><h2>{row[1]}</h2><div class="scene-rule"></div><p>{row[2]}</p></div></article>)}</section>}
{page==='characters' && <section class="section character-gallery">{t.characters.map((c:string[],i:number)=><article class="character-tile"><div class:list={['character-portrait',ids[i]]}><img src={path(ids[i]+'-scene.webp')} alt={c[0]} width="1024" height="1536" loading="lazy"/></div><div class="character-copy"><p class="eyebrow">{c[1]}</p><h2>{c[0]}</h2><p>{c[2]}</p><a class="text-link" href={local('characters/'+ids[i])}>{c[0]} →</a></div></article>)}</section>}
{page.startsWith('characters/') && <article class="prose"><div class:list={['character-portrait',ids[charIndex]]}><img src={path(ids[charIndex]+'-scene.webp')} alt={title} width="1024" height="1536"/></div><p>{t.characters[charIndex][2]}</p><a class="text-link" href={local('read')}>{u.read} →</a></article>}
{page==='blog' && <section class="section journal-grid journal-index">{t.essays.map((e:string[],i:number)=><a class="journal-card" href={local('blog/'+essayIds[i])}><div class="journal-art editorial-art"><img src={path(journalArt(essayIds[i]).file)} alt="" width="1200" height="800" loading="lazy"/></div><p class="eyebrow">{t.journalTitle} · 0{i+1}</p><h2>{e[0]}</h2><p>{e[1]}</p><span class="text-link">{t.essay} →</span></a>)}</section>}
{page.startsWith('blog/') && <article><figure class="article-visual editorial-art"><img src={path(journalArt(essayIds[essayIndex]).file)} alt="" width="1200" height="800"/></figure><div class="prose">{t.essays[essayIndex].slice(2).map((p:string)=><p>{p}</p>)}<a class="text-link" href={local('read')}>{u.read} →</a></div></article>}
{page==='film' && <article class="prose localized-watch"><VideoPlayer lang={lang}/><h2>{t.filmTitle}</h2><p>{t.filmIntro}</p><p>{t.filmLang}</p><h2 dir="ltr">A Monster’s Mother</h2><p>{t.filmDistinction}</p><a class="text-link" href={local('read')}>{u.read} →</a></article>}
{page==='read' && <article class="prose"><p>{t.readIntro}</p><div lang="en" dir="ltr"><h2>The First Breath</h2>{Chapter && <Chapter/>}</div></article>}
<section class="book-band"><p>{t.note}</p><a class="button" href="https://www.amazon.com/dp/B0HKYDF7BY" target="_blank" rel="noopener noreferrer">{u.buy} · Amazon ↗</a></section>
</Layout>
