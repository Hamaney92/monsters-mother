---
import ArtImage from "../../components/ArtImage.astro";
import Layout from '../../layouts/Layout.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import FilmBookInvitation from '../../components/FilmBookInvitation.astro';
import TurkishFilmGuide from '../../components/TurkishFilmGuide.astro';
import LocalizedBookGuide from '../../components/LocalizedBookGuide.astro';
import ReadingTools from '../../components/ReadingTools.astro';
import ArchiveGuide from '../../components/ArchiveGuide.astro';
import { readingRoute, type ReadingLanguage } from '../../data/reader';
import { localizedCharacterGuides, type LocalizedCharacterLanguage } from '../../data/localizedCharacterGuides';
import { localizedStoryPreview } from '../../data/localizedStoryPreview';
import { localizedDragonEssay } from '../../data/localizedDragonEssay';
import {getEntry,render} from 'astro:content';
import {copy,ui,routeFor,essayIds} from '../../data/i18n';
import {journalArt} from '../../data/journalArt';
import {path} from '../../site';
export function getStaticPaths(){return ['fr','ar','tr'].flatMap(lang=>['','story','world','characters','lore','blog','film','read',...['elara','ember','nessa'].map(x=>'characters/'+x),...essayIds.map(x=>'blog/'+x)].map(page=>({params:{lang,page:page||undefined}})));}
const lang=Astro.params.lang!;const page=Astro.params.page||'';const t=copy[lang],u=ui[lang];
const storyPreview=localizedStoryPreview[lang as keyof typeof localizedStoryPreview];
const ids=['elara','ember','nessa'] as const;
const charIndex=ids.findIndex(id=>id===page.split('/')[1]);
const essayIndex=essayIds.indexOf(page.split('/')[1]);
const dragonEssay=page==='blog/she-gave-birth-to-a-dragon'
  ? localizedDragonEssay[lang as keyof typeof localizedDragonEssay]
  : undefined;
const characterGuide=page.startsWith('characters/') && charIndex>=0
  ? localizedCharacterGuides[lang as LocalizedCharacterLanguage][ids[charIndex]]
  : undefined;
const title=page.startsWith('blog/')?t.essays[essayIndex][0]:page.startsWith('characters/')?t.characters[charIndex][0]:({'':t.sub,story:t.storyTitle,world:t.worldTitle,characters:t.charactersTitle,lore:t.loreTitle,blog:t.journalTitle,film:t.filmTitle,read:t.readTitle} as Record<string,string>)[page];
const descriptions:Record<string,string>={
  '':t.story,story:t.story2,world:({fr:'De la grotte enneigée au foyer d’Elara, découvrez les lieux où commence la vie d’Ember dans A Monster’s Mother.',tr:'Karlı mağaradan Elara’nın evine: A Monster’s Mother romanında Ember’ın hayatının başladığı yerleri keşfedin.',ar:'من الكهف الثلجي إلى منزل إلارا، اكتشف الأماكن التي تبدأ فيها حياة إمبر في رواية A Monster’s Mother.'} as Record<string,string>)[lang],
  characters:`${t.charactersTitle} ${t.characters.map((c:string[])=>c[0]+' — '+c[1]).join(' · ')}`,
  lore:({fr:'Le nom d’Ember, le châle d’Elara et la chaleur du foyer : explorez les objets et les symboles des premiers chapitres.',tr:'Ember’ın adı, Elara’nın şalı ve ocağın sıcaklığı: romanın ilk bölümlerindeki eşyaların ve simgelerin anlamlarını keşfedin.',ar:'اسم إمبر وشال إلارا ودفء الموقد: اكتشف معاني الأشياء والرموز في الفصول الأولى من الرواية.'} as Record<string,string>)[lang],
  blog:t.journalIntro,film:t.filmIntro,read:`${t.readIntro} ${t.note}`
};
const description=page.startsWith('blog/')?t.essays[essayIndex][1]:page.startsWith('characters/')?t.characters[charIndex][2]:descriptions[page];
const local=(p='')=>path(routeFor(lang,p));
const homeReadHref=lang==='tr'?path('tr/read/book/1/'):local('read');
const homeReadLabel=lang==='tr'?'Kitabı Türkçe ücretsiz oku':u.read;
const chapter=page==='read'?await getEntry('chapters','book-one-chapter-one'):undefined;const rendered=chapter?await render(chapter):undefined;const Chapter=rendered?.Content;
---
<Layout lang={lang} title={page.startsWith('characters/')?title+' — '+t.characters[charIndex][1]:title} description={description} schema={{'@context':'https://schema.org','@type':page.startsWith('blog/')?'BlogPosting':'WebPage',name:title,inLanguage:lang,url:new URL(Astro.url.pathname,Astro.site).href}}>
{page==='' ? <><section class="hero"><ArtImage class="hero-art" src={path('cover-art.webp')} alt="" width="1024" height="1536" fetchpriority="high"/><div class="hero-shade"></div><div class="hero-content"><p class="eyebrow">{t.sub}</p><h1 dir="ltr">A Monster’s<br/><em>Mother</em></h1><p class="subtitle" dir="ltr">A CRADLE MADE OF EMBERS</p><p class="hero-quote">{t.tag}</p><div class="actions"><a class="button" href={homeReadHref}>{homeReadLabel} →</a><a class="text-link" href={local('movie')}>{t.watch} ▶</a></div></div></section><section class="section intro"><h2>{t.storyTitle}</h2><div><p>{t.story}</p><a class="text-link" href={homeReadHref}>{homeReadLabel} →</a></div></section><section class="section portal-grid">{['world','characters','lore'].map((p,i)=><a class="portal" href={local(p)}><ArtImage class="portal-image" src={path(['world-art.webp','elara-scene.webp','lore-art.webp'][i])} alt="" width="1200" height="800" loading="lazy"/><span class="portal-number">0{i+1}</span><h2>{u.nav[i+1]}</h2></a>)}</section><section class="book-band"><h2>{t.journalTitle}</h2><p>{t.journalIntro}</p><a class="button secondary" href={local('blog')}>{u.nav[4]} →</a></section></> : <section class="page-heading"><p class="eyebrow" dir="ltr">A MONSTER’S MOTHER · YH</p><h1>{title}</h1><p>{description}</p></section>}
{page==='story' && <article class="prose">
  <p class="lead">{t.story}</p>
  <h2>{storyPreview.heading}</h2>
  {storyPreview.paragraphs.map(paragraph => <p>{paragraph}</p>)}
  <p><a class="text-link" href={path(readingRoute(lang, 1))}>{storyPreview.start} <span aria-hidden="true">{lang==='ar'?'←':'→'}</span></a></p>
  <ArtImage src={path('elara-scene.webp')} width="1024" height="1536" alt={t.characters[0][0]} loading="lazy"/>
  <LocalizedBookGuide lang={lang}/>
</article>}
{(page==='world'||page==='lore') && <ArchiveGuide lang={lang as ReadingLanguage} section={page}/>}
{page==='characters' && <section class="section character-gallery">{t.characters.map((c:string[],i:number)=><article class="character-tile"><div class:list={['character-portrait',ids[i]]}><ArtImage src={path(ids[i]+'-scene.webp')} alt={c[0]} width="1024" height="1536" loading="lazy"/></div><div class="character-copy"><p class="eyebrow">{c[1]}</p><h2>{c[0]}</h2><p>{c[2]}</p><a class="text-link" href={local('characters/'+ids[i])}>{c[0]} →</a></div></article>)}</section>}
{characterGuide && (
  <article class="prose" data-character-guide={ids[charIndex]}>
    <div class:list={['character-portrait',ids[charIndex]]}>
      <ArtImage src={path(ids[charIndex]+'-scene.webp')} alt={title} width="1024" height="1536"/>
    </div>
    <p>{t.characters[charIndex][2]}</p>
    <p class="source-note">{characterGuide.scope}</p>
    {characterGuide.paragraphs.map(paragraph => <p>{paragraph}</p>)}
    <a class="text-link" href={path(readingRoute(lang, characterGuide.chapter))}>
      {characterGuide.linkLabel} {lang==='ar'?'←':'→'}
    </a>
  </article>
)}
{page==='blog' && <section class="section journal-grid journal-index">{t.essays.map((e:string[],i:number)=><a class="journal-card" href={local('blog/'+essayIds[i])}><div class="journal-art editorial-art"><ArtImage src={path(journalArt(essayIds[i]).file)} alt="" width="1200" height="800" loading="lazy"/></div><p class="eyebrow">{t.journalTitle} · 0{i+1}</p><h2>{e[0]}</h2><p>{e[1]}</p><span class="text-link">{t.essay} →</span></a>)}</section>}
{page.startsWith('blog/') && <article>
  <figure class="article-visual editorial-art">
    <ArtImage src={path(journalArt(essayIds[essayIndex]).file)} alt="" width="1200" height="800"/>
  </figure>
  <div class="prose">
    {dragonEssay ? <>
      <p class="lead">{dragonEssay.intro}</p>
      <p><a class="text-link" href={local('film')}>{dragonEssay.filmLabel}</a></p>
      {dragonEssay.sections.map(({ heading, paragraphs }) => <>
        <h2>{heading}</h2>
        {paragraphs.map(paragraph => <p>{paragraph}</p>)}
      </>)}
      <p><a class="text-link" href={path(readingRoute(lang, 1))}>{storyPreview.start}</a></p>
      <p><a class="text-link" href={path(readingRoute(lang, 2))}>{dragonEssay.chapter2Label}</a></p>
    </> : <>
      {t.essays[essayIndex].slice(2).map((p:string)=><p>{p}</p>)}
      <a class="text-link" href={local('read')}>{u.read} →</a>
    </>}
  </div>
</article>}
{page==='film' && <article class="prose localized-watch"><VideoPlayer lang={lang}/><FilmBookInvitation lang={lang}/>{lang==='tr' ? <TurkishFilmGuide/> : <><h2>{t.filmTitle}</h2><p>{t.filmIntro}</p><p>{t.filmLang}</p><h2 dir="ltr">A Monster’s Mother</h2><p>{t.filmDistinction}</p><a class="text-link" href={local('read')}>{u.read} →</a></>}</article>}
{page==='read' && <><ReadingTools lang={lang}/><article class="prose"><p>{t.readIntro}</p><div lang="en" dir="ltr" data-reading-content><h2>The First Breath</h2>{Chapter && <Chapter/>}</div><div class="actions"><a class="text-link" href={local('characters')}>{t.charactersTitle} →</a><a class="text-link" href={local('world')}>{t.worldTitle} →</a></div></article></>}
{!(lang==='tr' && page==='film') && <section class="book-band"><p>{t.note}</p><a class="button" href="https://www.amazon.com/dp/B0HKYDF7BY" target="_blank" rel="noopener noreferrer">{u.buy} · Amazon ↗</a></section>}
</Layout>
