---
import ArtImage from "../components/ArtImage.astro";
import HeroPreload from "../components/HeroPreload.astro";
import FontPreloads from "../components/FontPreloads.astro";
import '../styles/global.css';
import { site, path } from '../site';
import Amazon from '../components/Amazon.astro';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import TurkishDiscoveryGuide from '../components/TurkishDiscoveryGuide.astro';
import {ui,names,routeFor,equivalents,sections} from '../data/i18n';
interface Props { lang?: string; alternates?: {lang:string; route:string}[]; title?: string; description?: string; noindex?: boolean; article?: boolean; schema?: Record<string, unknown>; }
const { lang = "en", title, description = site.description, noindex = false, article = false, schema } = Astro.props;
const u=ui[lang]||ui.en;
const relative=Astro.url.pathname.slice(import.meta.env.BASE_URL.replace(/\/$/,'').length).replace(/^\/|\/$/g,'');
const rawSection=relative.replace(/^(fr|ar|tr)(\/|$)/,'');
const currentSection=rawSection==='film'||rawSection==='watch'?'movie':rawSection.startsWith('404')?'':rawSection;
const bookMenuLabel:Record<string,string>={en:'Book · Read Chapter One',fr:'Livre · Chapitre 1 (anglais)',ar:'الكتاب · الفصل الأول بالإنجليزية',tr:'Kitap · İlk bölüm (İngilizce)'};
const localizedNav=[...sections.map((section,i)=>[u.nav[i],routeFor(lang,section)]),[bookMenuLabel[lang]||bookMenuLabel.en,routeFor(lang,'read')]];
const languageLinks=equivalents(currentSection);
const fullTitle = title ? `${title} | ${site.title}` : `${site.title}: ${site.subtitle}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL(path('social.jpg'), Astro.site);
const preview = Astro.site?.hostname === 'example.com';
---
<!doctype html><html lang={lang} dir={lang==='ar'?'rtl':'ltr'}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><HeroPreload enabled={rawSection===''} /><FontPreloads lang={lang} homepage={rawSection===''} /><meta name="google-site-verification" content="Wvu2FWUpwyz-XHfkdgERG3D3lCrOl3GeM9QqhvFPG7A"/><meta name="theme-color" content="#111110"/><title>{fullTitle}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>{languageLinks.map(item=><link rel="alternate" hreflang={item.lang} href={new URL(path(item.route),Astro.site)}/>)}<meta name="robots" content={noindex || preview ? 'noindex, follow' : 'index, follow'}/><meta property="og:type" content={article ? 'article' : 'website'}/><meta property="og:title" content={fullTitle}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:site_name" content={site.title}/><meta property="og:locale" content={lang === "ar" ? "ar_AR" : lang === "fr" ? "fr_FR" : lang === "tr" ? "tr_TR" : "en_US"}/><meta property="og:image" content={image}/><meta property="og:image:width" content="1024"/><meta property="og:image:height" content="1536"/><meta property="og:image:alt" content="Elara beside Ember, the pearl-pink dragon from the book’s cover"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={fullTitle}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={image}/><meta name="twitter:image:alt" content="Elara and Ember from A Monster’s Mother"/><link rel="icon" type="image/png" sizes="96x96" href={path('favicon-96.png')}/><link rel="icon" type="image/svg+xml" href={path('favicon.svg')}/><link rel="alternate" type="application/rss+xml" title="The Ember Journal" href={path('rss.xml')}/>{schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}/>}</head>
<body><a class="skip" href="#main">{u.skip}</a><header class="header"><a class="brand" href={path(routeFor(lang))} aria-label="A Monster’s Mother home"><ArtImage class="brand-emblem" src={path("brand-dragon.png")} width="64" height="64" alt="" aria-hidden="true"/><span class="brand-wordmark">A MONSTER’S<br/><strong>MOTHER</strong><small>A CRADLE MADE OF EMBERS</small></span></a><nav class="desktop-nav" aria-label="Main navigation">{localizedNav.map(([label,url]) => <a href={path(url)} aria-current={Astro.url.pathname.startsWith(path(url)) ? 'page' : undefined}>{label}</a>)}</nav><div class="header-actions"><Amazon compact lang={lang}/><button class="menu-toggle" aria-expanded="false" aria-controls="mobile-nav">{u.menu} <span aria-hidden="true">☰</span></button></div><nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" hidden>{localizedNav.map(([label,url]) => <a href={path(url)} aria-current={Astro.url.pathname.startsWith(path(url)) ? 'page' : undefined}>{label}</a>)}</nav></header>
<nav class="language-switch" aria-label="Language">{languageLinks.filter(l=>l.lang!=='x-default').map(l=><a href={path(l.route)} lang={l.lang} hreflang={l.lang} aria-current={l.lang===lang?'page':undefined}>{names[l.lang]}</a>)}</nav><main id="main"><slot/>{lang==='tr' && relative==='tr' && <TurkishDiscoveryGuide/>}</main><footer><div class="footer-top"><a class="footer-title" href={path(routeFor(lang))}>A Monster’s Mother<span>A Cradle Made of Embers</span></a><p>{u.footer}</p><a href={path(routeFor(lang,'read'))}>{u.read} <span aria-hidden="true">↗</span></a></div><div class="footer-bottom"><span>© {new Date().getFullYear()} YH · A Monster’s Mother</span><span>{u.art}</span><a href={path('rss.xml')}>Journal RSS</a><AnalyticsConsent lang={lang}/></div></footer>
<script>const button = document.querySelector<HTMLButtonElement>('.menu-toggle'); const menu = document.querySelector<HTMLElement>('#mobile-nav'); function closeMenu(){ if(button && menu){button.setAttribute('aria-expanded','false');menu.hidden=true;} } button?.addEventListener('click',()=>{if(menu){const open=button.getAttribute('aria-expanded')==='true';button.setAttribute('aria-expanded',String(!open));menu.hidden=open;}});document.addEventListener('keydown',event=>{if(event.key==='Escape' && button?.getAttribute('aria-expanded')==='true'){closeMenu();button.focus();}});window.matchMedia('(min-width: 1441px)').addEventListener('change', event=>{if(event.matches)closeMenu();});</script>
</body></html>

