---
import '../styles/global.css';
import { site, path, nav } from '../site';
import Amazon from '../components/Amazon.astro';
interface Props { lang?: string; alternates?: {lang:string; route:string}[]; title?: string; description?: string; noindex?: boolean; article?: boolean; schema?: Record<string, unknown>; }
const { lang = "en", alternates = [], title, description = site.description, noindex = false, article = false, schema } = Astro.props;
const fullTitle = title ? `${title} | ${site.title}` : `${site.title}: ${site.subtitle}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL(path('social.jpg'), Astro.site);
const preview = Astro.site?.hostname === 'example.com';
---
<!doctype html><html lang={lang}><head><meta name="google-site-verification" content="Wvu2FWUpwyz-XHfkdgERG3D3lCrOl3GeM9QqhvFPG7A"/><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#111110"/><title>{fullTitle}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>{alternates.map(item=><link rel="alternate" hreflang={item.lang} href={new URL(path(item.route),Astro.site)}/>)}<meta name="robots" content={noindex || preview ? 'noindex, follow' : 'index, follow'}/><meta property="og:type" content={article ? 'article' : 'website'}/><meta property="og:title" content={fullTitle}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:site_name" content={site.title}/><meta property="og:locale" content={lang === "ar" ? "ar_AR" : lang === "fr" ? "fr_FR" : "en_US"}/><meta property="og:image" content={image}/><meta property="og:image:width" content="1024"/><meta property="og:image:height" content="1536"/><meta property="og:image:alt" content="Elara beside Ember, the pearl-pink dragon from the book’s cover"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={fullTitle}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={image}/><meta name="twitter:image:alt" content="Elara and Ember from A Monster’s Mother"/><link rel="icon" type="image/svg+xml" href={path('favicon.svg')}/><link rel="alternate" type="application/rss+xml" title="The Ember Journal" href={path('rss.xml')}/>{schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}/>}</head>
<body><a class="skip" href="#main">Skip to content</a><header class="header"><a class="brand" href={path()} aria-label="A Monster’s Mother home"><span class="sigil" aria-hidden="true">✧</span><span>A MONSTER’S<br/><strong>MOTHER</strong></span></a><nav class="desktop-nav" aria-label="Main navigation">{nav.map(([label,url]) => <a href={path(url)} aria-current={Astro.url.pathname.startsWith(path(url)) ? 'page' : undefined}>{label}</a>)}</nav><div class="header-actions"><Amazon compact/><button class="menu-toggle" aria-expanded="false" aria-controls="mobile-nav">Menu <span aria-hidden="true">☰</span></button></div><nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" hidden>{nav.map(([label,url]) => <a href={path(url)}>{label}</a>)}<a href={path('read/')}>Read Chapter One</a></nav></header>
<main id="main"><slot/></main><footer><div class="footer-top"><a class="footer-title" href={path()}>A Monster’s Mother<span>A Cradle Made of Embers</span></a><p>For the ones we love.<br/>For the monsters we become.</p><a href={path('read/')}>Read Chapter One <span aria-hidden="true">↗</span></a></div><div class="footer-bottom"><span>© {new Date().getFullYear()} YH · A Monster’s Mother</span><span>Elara & Ember · Original cover artwork</span><a href={path('rss.xml')}>Journal RSS</a></div></footer>
<script>const button = document.querySelector<HTMLButtonElement>('.menu-toggle'); const menu = document.querySelector<HTMLElement>('#mobile-nav'); function closeMenu(){ if(button && menu){button.setAttribute('aria-expanded','false');menu.hidden=true;} } button?.addEventListener('click',()=>{if(menu){const open=button.getAttribute('aria-expanded')==='true';button.setAttribute('aria-expanded',String(!open));menu.hidden=open;}});document.addEventListener('keydown',event=>{if(event.key==='Escape' && button?.getAttribute('aria-expanded')==='true'){closeMenu();button.focus();}});window.matchMedia('(min-width: 961px)').addEventListener('change', event=>{if(event.matches)closeMenu();});</script>
</body></html>

